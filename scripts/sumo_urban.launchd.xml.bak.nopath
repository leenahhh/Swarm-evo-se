<?xml version="1.0"?>
<!-- TraCI launchd config for urban scenario -->
<launch>
    <copy file="/home/leena/swarm-evo-se/scripts/urban.net.xml"/>
    <copy file="/home/leena/swarm-evo-se/scripts/urban.rou.xml"/>
    <sumo-launchd port="9999" seed="23423">
        <basedir path="/home/leena/swarm-evo-se/scripts"/>
        <simulate>
            <sumo-options>
                <option name="net-file"   value="urban.net.xml"/>
                <option name="route-files" value="urban.rou.xml"/>
                <option name="step-length" value="0.1"/>
                <option name="collision.action" value="warn"/>
            </sumo-options>
        </simulate>
    </sumo-launchd>
</launch>
