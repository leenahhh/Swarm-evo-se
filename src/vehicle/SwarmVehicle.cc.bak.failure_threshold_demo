void SwarmVehicle::finish() {
    // Record final statistics as OMNeT++ scalars (appear in result files)
    recordScalar("msgSent",            msgSent_);
    recordScalar("msgReceived",        msgReceived_);
    recordScalar("msgDropped",         msgDropped_);
    recordScalar("cacheHits",          cacheHits_);
    recordScalar("revocationsIssued",  revocationsIssued_);
