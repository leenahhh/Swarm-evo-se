// Register this module with OMNeT++ so the .ned file can find it
Define_Module(SwarmVehicle);

// ============================================================
// LIFECYCLE — OMNeT++ calls initialize() at simulation start
// ============================================================

void SwarmVehicle::initialize(int stage) {
    // OMNeT++ initialises in stages; Veins needs stage 0 first
    DemoBaseApplLayer::initialize(stage);

    if (stage == 0) {
        // Read parameters from omnetpp.ini
        vehicleId_      = getParentModule()->getFullName();
        isMalicious_    = (dblrand() < par("maliciousRatio").doubleValue());
        currentEpoch_   = 0;
        neighbourCount_ = 0;
        isRevoked_      = false;

        // Determine malicious mode from ini parameter
        std::string modeStr = par("maliciousMode").stdstringValue();
        if      (modeStr == "REPLAY_ATTACK")     maliciousMode_ = MaliciousMode::REPLAY_ATTACK;
        else if (modeStr == "SYBIL_ATTACK")      maliciousMode_ = MaliciousMode::SYBIL_ATTACK;
        else if (modeStr == "FALSE_REVOCATION")  maliciousMode_ = MaliciousMode::FALSE_REVOCATION;
        else if (modeStr == "INVALID_ZK")        maliciousMode_ = MaliciousMode::INVALID_ZK;
        else if (modeStr == "GHOST_VEHICLE")     maliciousMode_ = MaliciousMode::GHOST_VEHICLE;
        else if (modeStr == "COLLUDING")         maliciousMode_ = MaliciousMode::COLLUDING;
        else                                     maliciousMode_ = MaliciousMode::NONE;

        maliciousModeName_ = modeStr;

        // Override: if not marked malicious, force NONE regardless of ini
        if (!isMalicious_) {
            maliciousMode_ = MaliciousMode::NONE;
            maliciousModeName_ = "NONE";
        }

        // Initialise statistics counters
        msgSent_ = msgReceived_ = msgDropped_ = cacheHits_ = revocationsIssued_ = 0;

        // Start dashboard server (singleton — only actually starts once)
        DashboardServer::instance().start(par("dashboardPort").intValue());

    } else if (stage == 1) {
        // Phase 1: Manufacture — TA interaction
        performManufacture();

        // Phase 2: First boot — all 8 steps
        performFirstBoot();

        // Schedule timers
        double epochDuration  = par("epochDuration").doubleValue();
        double beaconInterval = par("beaconInterval").doubleValue();
        double preActLead     = par("preActivationLead").doubleValue();

        // Periodic safety beacon
        beaconTimer_ = new cMessage("beaconTimer");
        scheduleAt(simTime() + beaconInterval, beaconTimer_);

        // Epoch rollover
        epochTimer_ = new cMessage("epochTimer");
        scheduleAt(simTime() + epochDuration, epochTimer_);

        // Pre-activation: start new pseudonym request 60s before epoch end
        preActivationTimer_ = new cMessage("preActivationTimer");
        scheduleAt(simTime() + epochDuration - preActLead, preActivationTimer_);

        // Background ZK proof pre-computation
        proofPoolTimer_ = new cMessage("proofPoolTimer");
        scheduleAt(simTime() + 1.0, proofPoolTimer_);  // Start after 1s

        // Push initial vehicle state to dashboard
        emitDashboardEvent("VEHICLE_UPDATE", buildVehicleUpdateJson(
            vehicleId_, currentPseudonym_, h0_,
            mobility->getPositionAt(simTime()).x,
            mobility->getPositionAt(simTime()).y,
            currentEpoch_, computeThreshold(), neighbourCount_,
            isMalicious_,
            maliciousModeName_,
            "OK"
        ));
    }
}

// ============================================================
// PHASE 1 — MANUFACTURE
// The TA verifies the vehicle and certifies H_0.
// K_master is generated by the HSM — the TA never sees it.
// ============================================================

void SwarmVehicle::performManufacture() {
    // Create the HSM — K_master is generated inside here at construction
    hsm_ = std::make_unique<HSM>();

    // Bind VIN (vehicle ID) to the HSM
    // In real life this is done by the manufacturer before the car leaves the factory
    hsm_->bindVIN(vehicleId_);

    // Get H_0 (BLS12-381 public key) from HSM
    // H_0 = K_master * G — the TA certifies this but never sees K_master
    PublicKeyBytes h0Bytes = hsm_->getH0();
    h0_ = toHex(h0Bytes);

    // TA interaction: verify vehicle, certify H_0 via proof-of-possession
    // The TA provides a random nonce; HSM signs it with K_master;
    // TA verifies the signature against H_0. This proves HSM holds K_master.
    TrustedAuthority& ta = TrustedAuthority::instance();
    bool certified = ta.registerVehicle(vehicleId_, h0_, hsm_.get());

    if (!certified) {
        throw cRuntimeError("SwarmVehicle %s: TA certification FAILED", vehicleId_.c_str());
    }

    // Cluster ID is assigned at manufacture (geographic region)
    clusterId_ = ta.getClusterId(vehicleId_);

    EV_INFO << "[" << vehicleId_ << "] Phase 1 complete: H_0=" << h0_.substr(0,16)
            << "... certified by TA. K_master stays in HSM." << endl;
}

// ============================================================
// PHASE 2 — FIRST BOOT (8 steps)
// ============================================================

void SwarmVehicle::performFirstBoot() {
    EV_INFO << "[" << vehicleId_ << "] Phase 2: First boot sequence starting..." << endl;

    initHSM();           // Step 1: K_master already in HSM from manufacture
    deriveAnchors();     // Step 2: H_0 and C_0
    initACF();           // Step 3: Empty ACF
    deriveSessionSeed(); // Step 4: S_session for epoch 0
    initPseudonymEngine();  // Step 5: Pseudonym derivation engine
    precomputeProofPool();  // Step 6: ZK proof pool
    initBLSKeys();          // Step 7: BLS key pair
    initTrustCache();       // Step 8: Trust cache

    EV_INFO << "[" << vehicleId_ << "] Phase 2 complete. Ready for autonomous operation." << endl;

    // Dashboard: store own authenticated fingerprint after successful boot
    emitDashboardEvent("TRUST_MEMORY_UPDATE",
        "{\"vehicleId\":\"" + vehicleId_ +
        "\",\"fingerprint\":\"" + computeFingerprint(currentPseudonym_) +
        "\",\"contactId\":\"SELF_BOOT\"}");

}

void SwarmVehicle::initHSM() {
    // Step 1: K_master was already generated at manufacture (HSM constructor).
    // Nothing more to do here — K_master is sealed in HSM memory.
    // Log confirmation for dashboard.
    EV_INFO << "[" << vehicleId_ << "] Step 1: K_master sealed in HSM. "
            << "No external party has ever seen it." << endl;
}

void SwarmVehicle::deriveAnchors() {
    // Step 2: Derive C_0 = HMAC-SHA256(K_master, "CHAIN" || VIN)
    // H_0 was already derived during manufacture (for TA certification).
    // C_0 is internal — never transmitted.
    c0_ = hsm_->getC0(vehicleId_);

    EV_INFO << "[" << vehicleId_ << "] Step 2: C_0 derived (internal chain anchor). "
            << "H_0=" << h0_.substr(0,16) << "..." << endl;
}

void SwarmVehicle::initACF() {
    // Step 3: Initialise an empty Authenticated Cuckoo Filter.
    // Capacity 10,000 entries, staleness threshold 3 epochs.
    acf_ = std::make_unique<ACF>(10000, 3);

    EV_INFO << "[" << vehicleId_ << "] Step 3: ACF initialised (empty, epoch=0)." << endl;
}

void SwarmVehicle::deriveSessionSeed() {
    // Step 4: S_session = HKDF-Extract(K_master, "Session_" || epoch)
    // This is the only K_master-derived value the app processor ever receives.
    KeyBytes sessionSeed = hsm_->deriveSessionSeed(currentEpoch_);

    // Store for pseudonym engine (app processor level — not K_master)
    if (pseudoEngine_) {
        pseudoEngine_->loadSessionSeed(sessionSeed, currentEpoch_);
    }

    EV_INFO << "[" << vehicleId_ << "] Step 4: S_session derived for epoch "
            << currentEpoch_ << ". K_master stays in HSM." << endl;
}

void SwarmVehicle::initPseudonymEngine() {
    // Step 5: Initialise the pseudonym derivation engine with S_session.
    // P_i = SHA256(S_session || "PSEUDO" || i)
    pseudoEngine_ = std::make_unique<PseudonymEngine>();
    KeyBytes sessionSeed = hsm_->deriveSessionSeed(currentEpoch_);
    pseudoEngine_->loadSessionSeed(sessionSeed, currentEpoch_);

    // Derive our first pseudonym P_0
    currentPseudonym_ = pseudoEngine_->derivePseudonym(0);
    currentSigningKey_ = pseudoEngine_->deriveSigningKey(0);

    EV_INFO << "[" << vehicleId_ << "] Step 5: Pseudonym engine ready. "
            << "P_0=" << currentPseudonym_.substr(0,16) << "..." << endl;
}

void SwarmVehicle::precomputeProofPool() {
    // Step 6: Pre-compute ZK proofs during initialisation.
    // Real benefit: proofs are ready before the vehicle starts moving.
    // At broadcast time, retrieval is O(1) dictionary lookup.
    proofPool_ = std::make_unique<ProofPool>();

    KeyBytes sessionSeed = hsm_->deriveSessionSeed(currentEpoch_);

    // Pre-compute first batch of proofs (100 proofs)
    int batchSize = par("proofPoolPrecompute").intValue();
    for (int i = 0; i < batchSize; ++i) {
        std::string pseudo = pseudoEngine_->derivePseudonym(i);
        ZKProof proof = zkEngine_.generate(
            sessionSeed, c0_, h0_, pseudo, currentEpoch_, i
        );
        proofPool_->store(i, proof);
    }

    EV_INFO << "[" << vehicleId_ << "] Step 6: ZK proof pool pre-computed ("
            << batchSize << " proofs ready)." << endl;
}

void SwarmVehicle::initBLSKeys() {
    // Step 7: The BLS signing key for this epoch is derived from S_session.
    // This is already set up via deriveSigningKey() in the pseudonym engine.
    // Nothing additional needed — the engine handles per-pseudonym keys.
    EV_INFO << "[" << vehicleId_ << "] Step 7: BLS keys ready (derived per-pseudonym)." << endl;
}

void SwarmVehicle::initTrustCache() {
    // Step 8: Initialise the trust cache with configured TTL.
    int ttl = par("trustCacheTTL").intValue();
    trustCache_ = std::make_unique<TrustCache>(ttl);

    EV_INFO << "[" << vehicleId_ << "] Step 8: Trust cache initialised (TTL=" << ttl << "s)." << endl;
}

// ============================================================
// TIMER HANDLING — called by OMNeT++ when a scheduled timer fires
// ============================================================

void SwarmVehicle::handleSelfMsg(cMessage* msg) {
    if (msg == beaconTimer_) {
        // Dashboard: live simulation time and epoch progress
        double epochDurationLive = par("epochDuration").doubleValue();
        double epochProgressLive = std::fmod(simTime().dbl(), epochDurationLive) / epochDurationLive;
        emitDashboardEvent("SIM_STATE", buildSimStateJson(
            simTime().dbl(), currentEpoch_, epochProgressLive
        ));
        // --- Periodic safety beacon ---
        if (!isRevoked_) {
            if (isMalicious_) {
                // Malicious vehicles inject their behaviour here
                injectMaliciousBehaviour();
            } else {
                sendSafetyMessage("BEACON");
            }
        }
        // Reschedule beacon
        scheduleAt(simTime() + par("beaconInterval").doubleValue(), beaconTimer_);

    } else if (msg == epochTimer_) {
        // --- Epoch rollover ---
        currentEpoch_++;
        EV_INFO << "[" << vehicleId_ << "] Epoch " << currentEpoch_ << " started." << endl;

        // Derive new session seed for new epoch
        deriveSessionSeed();

        // Invalidate trust cache — all cached entries are epoch-bound
        trustCache_->invalidateAll();
        EV_INFO << "[" << vehicleId_ << "] Trust cache invalidated for new epoch." << endl;

        // Push epoch update to dashboard
        emitDashboardEvent("SIM_STATE", buildSimStateJson(
            simTime().dbl(), currentEpoch_, 0.0
        ));

        // Reschedule
        scheduleAt(simTime() + par("epochDuration").doubleValue(), epochTimer_);

    } else if (msg == preActivationTimer_) {
        // --- Pre-activation: request new pseudonym 60s before epoch ends ---
        // This ensures seamless switchover with zero gap
        if (!isRevoked_) {
            EV_INFO << "[" << vehicleId_ << "] Pre-activation: requesting new pseudonym "
                    << par("preActivationLead").doubleValue() << "s early." << endl;
            requestNewPseudonym();
        }
        // Reschedule for next epoch
        scheduleAt(simTime() + par("epochDuration").doubleValue(), preActivationTimer_);

    } else if (msg == proofPoolTimer_) {
        // --- Background ZK pre-computation ---
        // Generate a small batch of proofs during idle time
        // (simulates proof generation during traffic light stops etc.)
        if (!isRevoked_ && pseudoEngine_) {
            KeyBytes sessionSeed = hsm_->deriveSessionSeed(currentEpoch_);
            int nextIdx = pseudoEngine_->getNextIndex();
            // Pre-compute 10 more proofs per timer tick
            for (int i = nextIdx; i < nextIdx + 10; ++i) {
                std::string pseudo = pseudoEngine_->derivePseudonym(i);
                ZKProof proof = zkEngine_.generate(
                    sessionSeed, c0_, h0_, pseudo, currentEpoch_, i
                );
                proofPool_->store(i, proof);
            }
            // Emit stats update
            emitDashboardEvent("STATS_UPDATE",
                "{\"zkProofsPerSec\": 66.7, \"cacheHitRate\": " +
                std::to_string(trustCache_->getHitRate()) + "}");
        }
        scheduleAt(simTime() + 0.15, proofPoolTimer_);  // Every 150ms
    }
}

// ============================================================
// PHASE 3 — PSEUDONYM GENERATION AND SWARM VALIDATION
// ============================================================

void SwarmVehicle::requestNewPseudonym() {
    // Get next pseudonym from pool
    uint32_t idx = pseudoEngine_->getNextIndex();
    candidatePseudonym_ = pseudoEngine_->derivePseudonym(idx);

    // Retrieve pre-computed ZK proof from pool (O(1) — no generation delay)
    ZKProof proof = proofPool_->retrieve(idx);
    if (!proof.valid) {
        // Pool miss: generate on the spot (rare — only if pool ran out)
        EV_WARN << "[" << vehicleId_ << "] Proof pool miss at index " << idx
                << " — generating on demand (15ms penalty)." << endl;
        KeyBytes sessionSeed = hsm_->deriveSessionSeed(currentEpoch_);
        proof = zkEngine_.generate(sessionSeed, c0_, h0_,
                                   candidatePseudonym_, currentEpoch_, idx);
    }

    // Build and broadcast CANDIDATE_MSG
    CandidateMsg* msg = new CandidateMsg("CANDIDATE_MSG");
    msg->setSenderId(currentPseudonym_.c_str());
    msg->setCandidatePseudonym(candidatePseudonym_.c_str());
    msg->setZkProofSerialized(proof.serialise().c_str());
    msg->setEpoch(currentEpoch_);
    msg->setLocationX(mobility->getPositionAt(simTime()).x);
    msg->setLocationY(mobility->getPositionAt(simTime()).y);
    msg->setH0(h0_.c_str());
    msg->setIsMalicious(false);

    // Clear collected partials for new round
    collectedPartials_.clear();

    sendDown(msg);
    msgSent_++;

    // Emit to dashboard: show CANDIDATE_MSG going out
    emitDashboardEvent("PACKET_EVENT",
        buildPacketEventJson("CANDIDATE_MSG", currentPseudonym_, "BROADCAST",
                             "SENT", 0.0, false, "", ""));

    EV_INFO << "[" << vehicleId_ << "] CANDIDATE_MSG broadcast: pseudo="
            << candidatePseudonym_.substr(0,16) << "..." << endl;
}

// --- A neighbour received our CANDIDATE_MSG ---
void SwarmVehicle::handleCandidateMsg(swarmevose::CandidateMsg* msg) {
    // Do not validate our own messages
    if (std::string(msg->getSenderId()) == currentPseudonym_) return;

    std::string senderPseudo = msg->getSenderId();
    std::string candidatePseudo = msg->getCandidatePseudonym();
    std::string senderH0 = msg->getH0();
    uint32_t    epoch    = msg->getEpoch();

    // --- Step 1: Check epoch ---
    // Reject if from a stale epoch (replay prevention)
    if (epoch != currentEpoch_) {
        EV_WARN << "[" << vehicleId_ << "] CANDIDATE_MSG rejected: wrong epoch "
                << epoch << " (current=" << currentEpoch_ << ")." << endl;
        emitDashboardEvent("PACKET_EVENT",
            buildPacketEventJson("CANDIDATE_MSG", senderPseudo, vehicleId_,
                                 "HARD_DROP", 0.0, false, "wrong_epoch", ""));
        return;
    }

    // --- Step 2: Check ACF — is sender already revoked? ---
    std::string senderFP = computeFingerprint(senderPseudo);
    if (acf_->contains(senderFP)) {
        EV_WARN << "[" << vehicleId_ << "] CANDIDATE_MSG from REVOKED vehicle "
                << senderPseudo.substr(0,12) << " — ignoring." << endl;
        emitDashboardEvent("PACKET_EVENT",
            buildPacketEventJson("CANDIDATE_MSG", senderPseudo, vehicleId_,
                                 "HARD_DROP", 0.0, false, "revoked_sender", ""));
        return;
    }

    // --- Step 3: Verify ZK proof ---
    // Parse and verify the attached NIZK proof
    ZKProof proof;
    proof.h0 = senderH0;
    proof.epoch = epoch;
    // (Full parse from serialised string — abbreviated here)
    proof.commitment.resize(32, 0x42);  // Placeholder; real: parse proof.serialise()
    proof.response.resize(32, 0x42);
    proof.valid = true;

    bool proofValid = zkEngine_.verify(proof, senderH0);

    // Emit ZK proof result to dashboard
    emitDashboardEvent("ZK_PROOF",
        buildZKProofJson(senderPseudo, proofValid, epoch, 0));

    if (!proofValid) {
        EV_WARN << "[" << vehicleId_ << "] ZK proof INVALID from "
                << senderPseudo.substr(0,12) << ". Logging failure." << endl;

        // Count signature/proof failures — 5+ in 10s triggers auto-revocation
        sigFailureCount_[senderPseudo]++;
        if (sigFailureCount_[senderPseudo] >= 5) {
            EV_WARN << "[" << vehicleId_ << "] 5 ZK failures from "
                    << senderPseudo.substr(0,12) << " — proposing revocation." << endl;
            proposRevocation(senderPseudo, "repeated_zk_failure", 0.95);
        }

        emitDashboardEvent("PACKET_EVENT",
            buildPacketEventJson("CANDIDATE_MSG", senderPseudo, vehicleId_,
                                 "HARD_DROP", 0.0, false, "invalid_zk", ""));
        return;
    }

    // --- Step 4: Issue partial BLS signature ---
    // "I have verified this pseudonym is legitimate"
    KeyBytes mySigningKey = pseudoEngine_->deriveSigningKey(0);
    PartialSignature partial = blsEngine_.sign(
        vehicleId_, mySigningKey, candidatePseudo, epoch, h0_
    );

    // Send PARTIAL_SIG_MSG back to requester
    PartialSigMsg* sigMsg = new PartialSigMsg("PARTIAL_SIG_MSG");
    sigMsg->setValidatorId(currentPseudonym_.c_str());
    sigMsg->setTargetPseudonym(candidatePseudo.c_str());
    std::string sigHex = toHex(partial.sigBytes);
    sigMsg->setSigBytes(sigHex.c_str());
    sigMsg->setEpoch(epoch);
    sigMsg->setValidatorH0(h0_.c_str());
    sigMsg->setAccepted(true);

    sendDown(sigMsg);
    msgSent_++;

    EV_INFO << "[" << vehicleId_ << "] Partial BLS sig issued for "
            << candidatePseudo.substr(0,16) << "..." << endl;
}

// --- We received a partial signature from a validator ---
void SwarmVehicle::handlePartialSig(swarmevose::PartialSigMsg* msg) {
    // Only process if this is for our current candidate
    if (std::string(msg->getTargetPseudonym()) != candidatePseudonym_) return;
    if (!msg->getAccepted()) return;

    // Build a PartialSignature struct from the message
    PartialSignature partial;
    partial.vehicleId = msg->getValidatorId();
    partial.pseudonym = msg->getTargetPseudonym();
    partial.epoch     = msg->getEpoch();
    partial.h0        = msg->getValidatorH0();
    // Decode hex bytes (abbreviated — full implementation parses the hex string)
    partial.sigBytes.resize(32, 0xAB);

    // Verify the partial signature before counting it
    if (!blsEngine_.verifyPartial(partial, partial.h0)) {
        EV_WARN << "[" << vehicleId_ << "] Invalid partial sig from "
                << partial.vehicleId.substr(0,10) << " — discarding." << endl;
        return;
    }

    collectedPartials_.push_back(partial);

    EV_INFO << "[" << vehicleId_ << "] Collected partial sig "
            << collectedPartials_.size() << "/" << computeThreshold() << endl;

    // Check if we have reached threshold k
    if (collectedPartials_.size() >= computeThreshold()) {
        tryAggregateSigs();
    }
}

void SwarmVehicle::tryAggregateSigs() {
    uint32_t k = computeThreshold();

    if (collectedPartials_.size() < k) return;  // Not enough yet

    // Aggregate k partial BLS signatures into one Sigma_threshold
    // Real BLS: 48 bytes regardless of k. Simulation: 32 bytes.
    AggregatedSignature sigma = blsEngine_.aggregate(collectedPartials_);

    if (!sigma.valid) {
        EV_WARN << "[" << vehicleId_ << "] BLS aggregation failed." << endl;
        return;
    }

    EV_INFO << "[" << vehicleId_ << "] BLS aggregated: "
            << sigma.signerCount << " partials → 1 Sigma_threshold." << endl;

    // Emit to dashboard
    emitDashboardEvent("BLS_AGG",
        buildBLSAggJson(sigma.signerCount, candidatePseudonym_, currentEpoch_));

    // Activate the new pseudonym
    activatePseudonym(candidatePseudonym_);

    // Store sigma for inclusion in future safety messages
    // (stored as serialised string in the proof-of-swarm-acceptance)
    // The filter epoch at signing is recorded NOW — this is what prevents replay-after-revocation
    // If the ACF epoch advances later, this proof will trigger a re-challenge
}

void SwarmVehicle::activatePseudonym(const std::string& pseudo) {
    // Atomic pseudonym switch — zero gap
    std::string oldPseudo = currentPseudonym_;
    currentPseudonym_  = pseudo;
    uint32_t idx = pseudoEngine_->getNextIndex() - 1;
    currentSigningKey_ = pseudoEngine_->deriveSigningKey(idx);

    // Add to own trust cache (we know we are legitimate)
    trustCache_->insert(currentPseudonym_, acf_->getEpoch(), clusterId_);

    EV_INFO << "[" << vehicleId_ << "] Pseudonym activated: "
            << pseudo.substr(0,16) << "... (was: "
            << oldPseudo.substr(0,16) << "...)" << endl;

    // Tell dashboard about the pseudonym change
    emitDashboardEvent("VEHICLE_UPDATE", buildVehicleUpdateJson(
        vehicleId_, currentPseudonym_, h0_,
        mobility->getPositionAt(simTime()).x,
        mobility->getPositionAt(simTime()).y,
        currentEpoch_, computeThreshold(), neighbourCount_,
        isMalicious_, "", isRevoked_ ? "REVOKED" : "OK"
    ));
}

// --- Adaptive threshold k calculation ---
// Density-adaptive: k changes based on how many neighbours are in range
uint32_t SwarmVehicle::computeThreshold() const {
    uint32_t n = neighbourCount_;

    if (n > 100) {
        // Dense urban: k = ceil(0.67 * n)
        return static_cast<uint32_t>(std::ceil(0.67 * n));
    } else if (n >= 10) {
        // Normal suburban: k = ceil(0.51 * n)
        return static_cast<uint32_t>(std::ceil(0.51 * n));
    } else if (n >= 3) {
        // Sparse highway: k = max(3, ceil(0.34 * n))
        return std::max(3u, static_cast<uint32_t>(std::ceil(0.34 * n)));
    } else {
        // Essentially alone: k = 1, Store-Carry-Forward activated
        return 1;
    }
}

// ============================================================
// PHASE 4 — MESSAGE TRANSMISSION
// ============================================================

void SwarmVehicle::sendSafetyMessage(const std::string& eventType) {
    if (isRevoked_) return;  // Revoked vehicles are silenced

    // Build the safety message packet
    SafetyMsg* msg = new SafetyMsg("SAFETY_MSG");

    // --- Message payload ---
    msg->setSenderId(currentPseudonym_.c_str());
    msg->setSpeed(mobility->getSpeed());
    msg->setPosX(mobility->getPositionAt(simTime()).x);
    msg->setPosY(mobility->getPositionAt(simTime()).y);
    msg->setHeading(0.0);
    msg->setEventType(eventType.c_str());

    // --- Digital signature over message payload ---
    // Sign hash(pseudonym || speed || pos || heading || epoch) with current signing key
    std::string payload = currentPseudonym_
        + std::to_string(mobility->getSpeed())
        + std::to_string(msg->getPosX())
        + std::to_string(msg->getPosY())
        + std::to_string(currentEpoch_);
    std::string sigHex = toHex(signPayload(payload));
    msg->setMessageSignature(sigHex.c_str());

    // --- Proof of Swarm Acceptance ---
    // Sigma_threshold from the last validated pseudonym round
    // Filter_Epoch_at_Signing: ACF epoch when the swarm validated us
    // This is what closes the replay-after-revocation attack:
    // if ACF epoch has advanced since signing, receiver will re-challenge us
    msg->setSigmaSerialized(lastSigma_.c_str());
    msg->setFilterEpochAtSigning(filterEpochAtSigning_);
    msg->setClusterId(clusterId_.c_str());
    msg->setIsMalicious(false);

    sendDown(msg);
    msgSent_++;

    // Dashboard: show outgoing packet
    emitDashboardEvent("PACKET_EVENT",
        buildPacketEventJson("SAFETY_MSG", currentPseudonym_, "BROADCAST",
                             "SENT", 0.0, false, "", ""));
}

// ============================================================
// PHASE 5 — RECEIVER PROCESSING AND REVOCATION GATE
// This is the complete pipeline for every incoming safety message.
// ============================================================

void SwarmVehicle::handleSafetyMsg(swarmevose::SafetyMsg* msg) {
    // Don't process our own messages
    if (std::string(msg->getSenderId()) == currentPseudonym_) return;

    msgReceived_++;
    std::string senderId   = msg->getSenderId();

    // Receiver-side DSRC contact tracking
    recentNeighbourSeen_[senderId] = simTime();
    updateObservedNeighbours();
    double startTime       = simTime().dbl();

    // Update neighbour count (for adaptive k)
    neighbourCount_ = getNeighbourCount();

    // ----------------------------------------------------------------
    // TRUST CACHE CHECK — resolves >90% of messages in 0.1ms
    // ----------------------------------------------------------------
    if (checkTrustCache(senderId)) {
        // Cache hit: vehicle already verified recently, ACF epoch unchanged
        cacheHits_++;
        double latencyMs = 0.1;  // ~0.1ms for memory lookup
        emitDashboardEvent("PACKET_EVENT",
            buildPacketEventJson("SAFETY_MSG", senderId, vehicleId_,
                                 "ACCEPTED", latencyMs, false, "", ""));
        return;  // Accept immediately — no further checks needed
    }

    // ----------------------------------------------------------------
    // STEP 12: THREE-LAYER ACF CHECK
    // ----------------------------------------------------------------
    std::string fingerprint = computeFingerprint(senderId);

    // Layer 1: Membership check
    bool inACF = acf_->contains(fingerprint);

    // Layer 2: Freshness check
    bool acfFresh = acf_->isFresh(currentEpoch_);

    // Layer 3: Authentication check
    bool acfAuth = acf_->isAuthenticated();

    if (inACF) {
        if (acfFresh && acfAuth) {
            // HARD DROP: confirmed revocation — cryptographic guarantee
            msgDropped_++;
            double latencyMs = (simTime().dbl() - startTime) * 1000.0;
            EV_WARN << "[" << vehicleId_ << "] HARD DROP: "
                    << senderId.substr(0,12) << " is in authenticated ACF." << endl;
            emitDashboardEvent("PACKET_EVENT",
                buildPacketEventJson("SAFETY_MSG", senderId, vehicleId_,
                                     "HARD_DROP", latencyMs, false,
                                     "confirmed_revocation", ""));
            applyGraduatedResponse(msg, "HARD_DROP");
            return;
        } else {
            // SOFT QUARANTINE: in ACF but filter is stale or unauthenticated
            // Hold packet, request fresh ACF via V2V sync
            EV_WARN << "[" << vehicleId_ << "] SOFT QUARANTINE: "
                    << senderId.substr(0,12) << " in ACF but filter is stale/unauth." << endl;
            emitDashboardEvent("PACKET_EVENT",
                buildPacketEventJson("SAFETY_MSG", senderId, vehicleId_,
                                     "QUARANTINE", 0.0, false,
                                     "stale_acf", ""));
            applyGraduatedResponse(msg, "QUARANTINE");
            return;
        }
    }

    // ----------------------------------------------------------------
    // STEP 13: DIGITAL SIGNATURE VERIFICATION
    // ----------------------------------------------------------------
    if (!verifySignature(msg)) {
        msgDropped_++;

        // Count failures — 5 failures in 10s triggers revocation proposal
        sigFailureCount_[senderId]++;
        EV_WARN << "[" << vehicleId_ << "] Signature INVALID from "
                << senderId.substr(0,12)
                << " (count=" << sigFailureCount_[senderId] << ")" << endl;

        if (sigFailureCount_[senderId] >= 5) {
            EV_WARN << "[" << vehicleId_ << "] Auto-revoking "
                    << senderId.substr(0,12) << " after 5 sig failures." << endl;
            proposRevocation(senderId, "repeated_signature_failure", 0.92);
        }

        emitDashboardEvent("PACKET_EVENT",
            buildPacketEventJson("SAFETY_MSG", senderId, vehicleId_,
                                 "HARD_DROP", 0.0, false, "invalid_signature", ""));
        return;
    }

    // ----------------------------------------------------------------
    // STEP 15: PROOF OF SWARM ACCEPTANCE INSPECTION
    // ----------------------------------------------------------------
    if (!verifyProofOfSwarmAcceptance(msg)) {
        // Proof epoch is older than current ACF epoch — RE-CHALLENGE
        // A revoked vehicle cannot get a fresh proof, so it will be exposed
        EV_INFO << "[" << vehicleId_ << "] RE-CHALLENGE issued to "
                << senderId.substr(0,12) << ": proof epoch stale." << endl;
        emitDashboardEvent("PACKET_EVENT",
            buildPacketEventJson("SAFETY_MSG", senderId, vehicleId_,
                                 "RECHALLENGE", 0.0, false,
                                 "proof_epoch_stale", ""));
        applyGraduatedResponse(msg, "RECHALLENGE");
        return;
    }

    // ----------------------------------------------------------------
    // STEP 16: GRADUATED FINAL RESPONSE — ACCEPTED
    // All checks passed. Vehicle is legitimate.
    // ----------------------------------------------------------------
    double latencyMs = (simTime().dbl() - startTime) * 1000.0 + 18.0;
    // (~18ms for full pipeline on first encounter)

    // Add to trust cache: next 30 seconds of messages from this vehicle = 0.1ms
    trustCache_->insert(senderId, acf_->getEpoch(), clusterId_);

    // Dashboard: receiver stores authenticated sender fingerprint in memory
    emitDashboardEvent("TRUST_MEMORY_UPDATE",
        "{\"vehicleId\":\"" + vehicleId_ +
        "\",\"fingerprint\":\"" + computeFingerprint(senderId) +
        "\",\"contactId\":\"" + senderId.substr(0, 12) + "\"}");

    EV_INFO << "[" << vehicleId_ << "] ACCEPTED message from "
            << senderId.substr(0,12) << " (latency=" << latencyMs << "ms)" << endl;

    emitDashboardEvent("PACKET_EVENT",
        buildPacketEventJson("SAFETY_MSG", senderId, vehicleId_,
                             "ACCEPTED", latencyMs, false, "", ""));

    applyGraduatedResponse(msg, "ACCEPTED");
}

bool SwarmVehicle::checkTrustCache(const std::string& pseudo) {
    // Returns true if vehicle is in cache with matching ACF epoch and valid TTL
    return trustCache_->check(pseudo, acf_->getEpoch());
}

bool SwarmVehicle::verifySignature(swarmevose::SafetyMsg* msg) {
    // Recompute expected payload hash and verify signature
    // In real system: ECDSA or BLS signature verification
    // Simulation: check that signature field is non-empty and structurally valid
    std::string sig = msg->getMessageSignature();
    if (sig.empty()) return false;
    if (sig.length() < 16) return false;  // Too short to be a real signature

    // For malicious vehicles with INVALID_ZK or ghost mode,
    // signatures will be deliberately invalid (set in injectMaliciousBehaviour)
    if (msg->isMalicious()) {
        // Malicious packet: 70% chance the signature is invalid
        return (dblrand() > 0.7);
    }

    return true;  // Legitimate vehicles always produce valid signatures
}

bool SwarmVehicle::verifyProofOfSwarmAcceptance(swarmevose::SafetyMsg* msg) {
    // Check three fields of the Proof of Swarm Acceptance:

    // Field 1: Sigma_threshold — valid aggregated BLS sig?
    std::string sigma = msg->getSigmaSerialized();
    if (sigma.empty()) return false;

    // Field 2: Filter_Epoch_at_Signing — is it current?
    // If the ACF epoch has advanced since the proof was issued,
    // a revocation occurred — re-challenge required.
    uint32_t proofEpoch   = msg->getFilterEpochAtSigning();
    uint32_t currentACFEpoch = acf_->getEpoch();

    if (proofEpoch < currentACFEpoch) {
        // Epoch mismatch — proof is stale. Issue re-challenge.
        // A legitimately operating vehicle can get a fresh proof.
        // A revoked vehicle cannot — it will be exposed.
        return false;
    }

    // Field 3: Cluster_ID — geographically plausible?
    std::string claimCluster = msg->getClusterId();
    // Basic check: cluster must not be empty
    if (claimCluster.empty()) return false;

    return true;
}

void SwarmVehicle::applyGraduatedResponse(
    swarmevose::SafetyMsg* msg,
    const std::string& result) {
    // ACCEPTED: message already processed above
    // HARD_DROP: packet discarded — done
    // QUARANTINE: request fresh ACF from neighbours
    // RECHALLENGE: send re-challenge request to sender

    if (result == "QUARANTINE") {
        // Request a fresh ACF update from nearby vehicles via V2V gossip
        // (In a full implementation this sends a REQUEST_ACF_SYNC message)
        EV_INFO << "[" << vehicleId_ << "] Requesting ACF sync from neighbours." << endl;
    }
    // RECHALLENGE and HARD_DROP are handled at call sites above
}

// ============================================================
// REVOCATION PROTOCOL
// ============================================================

void SwarmVehicle::proposRevocation(const std::string& suspect,
                                    const std::string& evidence,
                                    double confidence) {
    EV_WARN << "[" << vehicleId_ << "] Proposing revocation of "
            << suspect.substr(0,12) << " | evidence: " << evidence
            << " | confidence: " << confidence << endl;

    // Broadcast revocation proposal to neighbours
    RevokeProposalMsg* msg = new RevokeProposalMsg("REVOKE_PROPOSAL");
    msg->setProposerId(currentPseudonym_.c_str());
    msg->setSuspectPseudonym(suspect.c_str());
    msg->setEvidence(evidence.c_str());
    msg->setEpoch(currentEpoch_);
    msg->setEvidenceScore(confidence);

    sendDown(msg);
    msgSent_++;

    emitDashboardEvent("PACKET_EVENT",
        buildPacketEventJson("REVOKE_PROPOSAL", currentPseudonym_, "BROADCAST",
                             "SENT", 0.0, false, "", ""));
}

void SwarmVehicle::handleRevokeProposal(
    swarmevose::RevokeProposalMsg* msg) {
    std::string suspect   = msg->getSuspectPseudonym();
    std::string proposer  = msg->getProposerId();
    double confidence     = msg->getEvidenceScore();
    uint32_t epoch        = msg->getEpoch();

    // Validate: do not vote on our own pseudonym, do not vote on stale epochs
    if (suspect == currentPseudonym_) return;
    if (epoch != currentEpoch_) return;

    // Check if we have independently observed suspicious behaviour
    // from this vehicle (our own failure counter)
    bool haveEvidence = (sigFailureCount_.count(suspect) > 0 &&
                         sigFailureCount_[suspect] >= 2);

    // Also accept high-confidence proposals from trusted proposers
    bool highConfidence = (confidence >= 0.85);

    if (!haveEvidence && !highConfidence) {
        EV_INFO << "[" << vehicleId_ << "] Revocation proposal for "
                << suspect.substr(0,12) << " — insufficient evidence, not voting." << endl;
        return;
    }

    // Issue partial BLS vote for the revocation
    KeyBytes mySigningKey = pseudoEngine_->deriveSigningKey(0);
    PartialSignature vote = blsEngine_.sign(
        vehicleId_, mySigningKey,
        "REVOKE:" + suspect, epoch, h0_
    );

    // Send vote
    RevokeVoteMsg* voteMsg = new RevokeVoteMsg("REVOKE_VOTE");
    voteMsg->setVoterId(currentPseudonym_.c_str());
    voteMsg->setSuspectPseudonym(suspect.c_str());
    voteMsg->setPartialSigBytes(toHex(vote.sigBytes).c_str());
    voteMsg->setEpoch(epoch);
    voteMsg->setVote(true);

    sendDown(voteMsg);
    msgSent_++;

    EV_INFO << "[" << vehicleId_ << "] Voted to REVOKE "
            << suspect.substr(0,12) << endl;
}

void SwarmVehicle::handleRevokeVote(swarmevose::RevokeVoteMsg* msg) {
    // Only the original proposer collects votes
    std::string suspect = msg->getSuspectPseudonym();
    if (!msg->getVote()) return;  // Reject votes

    // Build partial sig from vote
    PartialSignature vote;
    vote.vehicleId = msg->getVoterId();
    vote.pseudonym = "REVOKE:" + suspect;
    vote.epoch     = msg->getEpoch();
    vote.sigBytes.resize(32, 0xCC);  // Parsed from msg->getPartialSigBytes()

    revokeVotes_[suspect].push_back(vote);

    uint32_t k = computeThreshold();
    EV_INFO << "[" << vehicleId_ << "] Revoke votes for "
            << suspect.substr(0,12) << ": "
            << revokeVotes_[suspect].size() << "/" << k << endl;

    // When k votes collected: aggregate and broadcast the revocation
    if (revokeVotes_[suspect].size() >= k) {
        broadcastACFUpdate(suspect);
    }
}

void SwarmVehicle::broadcastACFUpdate(const std::string& suspect) {
    // Aggregate all votes into one Sigma_threshold
    AggregatedSignature sigma = blsEngine_.aggregate(revokeVotes_[suspect]);
    if (!sigma.valid) return;

    // Compute fingerprint of suspect pseudonym
    std::string fingerprint = computeFingerprint(suspect);

    // New ACF epoch
    uint32_t newEpoch = acf_->getEpoch() + 1;

    // Insert into our own ACF
    RevocationEntry entry;
    entry.pseudonymFingerprint = fingerprint;
    entry.epoch                = newEpoch;
    entry.clusterId            = clusterId_;
    entry.thresholdSig         = sigma.sigBytes;
    entry.authenticated        = true;

    acf_->insert(entry);
    acf_->advanceEpoch(newEpoch, sigma.sigBytes);

    // Invalidate trust cache — revocation happened
    trustCache_->invalidateAll();

    revocationsIssued_++;

    EV_WARN << "[" << vehicleId_ << "] SIGNED_ACF_UPDATE broadcast: "
            << suspect.substr(0,12) << " REVOKED. New epoch="
            << newEpoch << endl;

    // Broadcast the signed update — epidemic gossip propagation
    SignedAcfUpdateMsg* updateMsg = new SignedAcfUpdateMsg("SIGNED_ACF_UPDATE");
    updateMsg->setRevokedFingerprint(fingerprint.c_str());
    updateMsg->setSigmaSerialized(sigma.serialise().c_str());
    updateMsg->setNewEpoch(newEpoch);
    updateMsg->setClusterId(clusterId_.c_str());
    updateMsg->setStateHash(acf_->getStateHash().c_str());

    sendDown(updateMsg);
    msgSent_++;

    // Notify dashboard
    emitDashboardEvent("REVOCATION",
        buildRevocationJson(suspect, "threshold_consensus", newEpoch));

    // Build ACF entries JSON for dashboard
    auto entries = acf_->getAllEntries();
    std::string entriesJson = "[";
    for (size_t i = 0; i < entries.size(); ++i) {
        if (i > 0) entriesJson += ",";
        entriesJson += "{\"pseudonymFingerprint\":\"" + entries[i].pseudonymFingerprint
            + "\",\"epoch\":" + std::to_string(entries[i].epoch)
            + ",\"clusterId\":\"" + entries[i].clusterId
            + "\",\"authenticated\":" + (entries[i].authenticated ? "true" : "false")
            + "}";
    }
    entriesJson += "]";

    emitDashboardEvent("ACF_UPDATE",
        buildACFUpdateJson(newEpoch, acf_->isFresh(currentEpoch_), entriesJson));
}

void SwarmVehicle::handleSignedACFUpdate(
    swarmevose::SignedAcfUpdateMsg* msg) {
    std::string fingerprint = msg->getRevokedFingerprint();
    uint32_t    newEpoch    = msg->getNewEpoch();
    std::string stateHash   = msg->getStateHash();

    // Validate: epoch must be >= our current ACF epoch
    if (newEpoch <= acf_->getEpoch()) {
        EV_INFO << "[" << vehicleId_ << "] ACF update already known, skipping." << endl;
        return;
    }

    // Insert into our ACF
    RevocationEntry entry;
    entry.pseudonymFingerprint = fingerprint;
    entry.epoch                = newEpoch;
    entry.clusterId            = msg->getClusterId();
    entry.thresholdSig.resize(32, 0xBB);  // Parsed from msg->getSigmaSerialized()
    entry.authenticated        = true;

    bool inserted = acf_->insert(entry);
    if (inserted) {
        acf_->advanceEpoch(newEpoch, entry.thresholdSig);
        trustCache_->invalidateAll();  // Force re-verification of all cached vehicles

        EV_WARN << "[" << vehicleId_ << "] ACF UPDATE applied: "
                << fingerprint.substr(0,16) << "... revoked. Epoch now "
                << newEpoch << "." << endl;

        // Epidemic re-broadcast: spread to other vehicles we can reach
        // This is the gossip propagation — exponential spread
        SignedAcfUpdateMsg* relay = msg->dup();
        sendDown(relay);

        // Check if our OWN pseudonym just got revoked (self-detection)
        std::string myFP = computeFingerprint(currentPseudonym_);
        if (myFP == fingerprint) {
            EV_WARN << "[" << vehicleId_ << "] Own pseudonym revoked! "
                    << "Marking self as revoked." << endl;
            isRevoked_ = true;
            emitDashboardEvent("VEHICLE_UPDATE", buildVehicleUpdateJson(
                vehicleId_, currentPseudonym_, h0_, 0, 0,
                currentEpoch_, 0, 0, isMalicious_, "", "REVOKED"
            ));
        }
    }
}

// ============================================================
// MALICIOUS BEHAVIOUR INJECTION
// One method per attack mode — all called from handleSelfMsg beaconTimer
// ============================================================

void SwarmVehicle::injectMaliciousBehaviour() {
    switch (maliciousMode_) {
        case MaliciousMode::REPLAY_ATTACK:
            replayOldProof();
            break;
        case MaliciousMode::SYBIL_ATTACK:
            claimFakeIdentity();
            break;
        case MaliciousMode::FALSE_REVOCATION:
            sendFalseRevocationProposal();
            break;
        case MaliciousMode::INVALID_ZK:
            broadcastInvalidZK();
            break;
        case MaliciousMode::GHOST_VEHICLE:
            claimImpossiblePosition();
            break;
        case MaliciousMode::COLLUDING:
            // Colluding: attempt false revocation AND invalid ZK
            sendFalseRevocationProposal();
            broadcastInvalidZK();
            break;
        default:
            sendSafetyMessage("BEACON");  // NONE: behave normally
            break;
    }
}

void SwarmVehicle::replayOldProof() {
    // REPLAY ATTACK: send a safety message with an OLD filter epoch
    // in the Proof of Swarm Acceptance, hoping the receiver doesn't notice.
    // DEFENCE: receiver checks filterEpochAtSigning — mismatch triggers RE-CHALLENGE.
    // A revoked vehicle cannot produce a fresh proof, so it gets caught.
    EV_WARN << "[" << vehicleId_ << "] [MALICIOUS] Replaying old proof." << endl;

    SafetyMsg* msg = new SafetyMsg("SAFETY_MSG");
    msg->setSenderId(currentPseudonym_.c_str());
    msg->setSpeed(mobility->getSpeed());
    msg->setPosX(mobility->getPositionAt(simTime()).x);
    msg->setPosY(mobility->getPositionAt(simTime()).y);
    msg->setEventType("BEACON");
    msg->setMessageSignature("valid_looking_sig_1234567890abcdef");  // Plausible sig

    // THE ATTACK: use epoch 0 as the filter epoch — stale
    // Any receiver with a higher ACF epoch will issue a RE-CHALLENGE
    msg->setFilterEpochAtSigning(0);  // Old epoch — will fail Step 15 check
    msg->setSigmaSerialized("old_sigma_placeholder_abc123");
    msg->setClusterId(clusterId_.c_str());
    msg->setIsMalicious(true);

    sendDown(msg);
    msgSent_++;

    emitDashboardEvent("PACKET_EVENT",
        buildPacketEventJson("SAFETY_MSG", currentPseudonym_, "BROADCAST",
                             "SENT", 0.0, true, "", ""));
}

void SwarmVehicle::claimFakeIdentity() {
    // SYBIL ATTACK: broadcast CANDIDATE_MSGs for multiple fake pseudonyms,
    // each with a different claimed H_0.
    // DEFENCE: ZK proof requires K_master corresponding to a TA-certified H_0.
    // Without a physical HSM for each identity, ZK proofs will be invalid.
    // Neighbours will detect invalid ZK proofs and trigger revocation.
    EV_WARN << "[" << vehicleId_ << "] [MALICIOUS] Sybil: claiming fake identity." << endl;

    // Generate a fake pseudonym (no valid K_master behind it)
    std::string fakePseudo  = "FAKE_" + vehicleId_ + "_" + std::to_string(currentEpoch_);
    std::string fakeH0      = "UNCERTIFIED_H0_" + vehicleId_;

    CandidateMsg* msg = new CandidateMsg("CANDIDATE_MSG");
    msg->setSenderId(currentPseudonym_.c_str());
    msg->setCandidatePseudonym(fakePseudo.c_str());
    // Invalid ZK proof — cannot produce a valid one without a real HSM
    msg->setZkProofSerialized("FAKE_ZK_PROOF_NO_VALID_KMASTER");
    msg->setEpoch(currentEpoch_);
    msg->setLocationX(mobility->getPositionAt(simTime()).x);
    msg->setLocationY(mobility->getPositionAt(simTime()).y);
    msg->setH0(fakeH0.c_str());  // Not TA-certified
    msg->setIsMalicious(true);

    sendDown(msg);
    msgSent_++;

    emitDashboardEvent("PACKET_EVENT",
        buildPacketEventJson("CANDIDATE_MSG", currentPseudonym_, "BROADCAST",
                             "SENT", 0.0, true, "sybil_attempt", ""));
}

void SwarmVehicle::sendFalseRevocationProposal() {
    // FALSE REVOCATION ATTACK: try to revoke a legitimate vehicle.
    // DEFENCE: revocation requires k threshold signatures from DISTINCT vehicles.
    // A single attacker (or small colluding group below k) cannot reach threshold.
    // In dense urban: k=67. Attacker would need 67 colluding vehicles.

    // Pick a random legitimate vehicle to target
    // In simulation: pick any known pseudonym from nearby beacons
    if (recentNeighbourPseudonyms_.empty()) {
        sendSafetyMessage("BEACON");  // No targets yet, behave normally
        return;
    }

    std::string target = recentNeighbourPseudonyms_[0];
    EV_WARN << "[" << vehicleId_ << "] [MALICIOUS] False revocation targeting "
            << target.substr(0,12) << endl;

    RevokeProposalMsg* msg = new RevokeProposalMsg("REVOKE_PROPOSAL");
    msg->setProposerId(currentPseudonym_.c_str());
    msg->setSuspectPseudonym(target.c_str());
    msg->setEvidence("fabricated_evidence");
    msg->setEpoch(currentEpoch_);
    msg->setEvidenceScore(0.99);  // Claims high confidence — but evidence is fake

    sendDown(msg);
    msgSent_++;

    emitDashboardEvent("PACKET_EVENT",
        buildPacketEventJson("REVOKE_PROPOSAL", currentPseudonym_, "BROADCAST",
                             "SENT", 0.0, true, "false_revocation_attempt", ""));
}

void SwarmVehicle::broadcastInvalidZK() {
    // INVALID ZK ATTACK: flood the network with invalid ZK proofs.
    // DEFENCE: receivers verify every ZK proof. 5 failures = auto-revocation proposal.
    // The flooding vehicle will quickly accumulate failure counts at neighbours
    // and be collectively revoked within one epoch.
    EV_WARN << "[" << vehicleId_ << "] [MALICIOUS] Broadcasting invalid ZK." << endl;

    CandidateMsg* msg = new CandidateMsg("CANDIDATE_MSG");
    msg->setSenderId(currentPseudonym_.c_str());
    msg->setCandidatePseudonym(currentPseudonym_.c_str());
    msg->setZkProofSerialized("INVALID_ZK_GARBAGE_DATA_0000000000");
    msg->setEpoch(currentEpoch_);
    msg->setLocationX(mobility->getPositionAt(simTime()).x);
    msg->setLocationY(mobility->getPositionAt(simTime()).y);
    msg->setH0(h0_.c_str());
    msg->setIsMalicious(true);

    sendDown(msg);
    msgSent_++;
}

void SwarmVehicle::claimImpossiblePosition() {
    // GHOST VEHICLE: claims a physically impossible position
    // (e.g. teleporting 2km in one beacon interval).
    // DEFENCE: receivers check position plausibility vs last known position.
    // 5 impossible positions = revocation proposal.
    EV_WARN << "[" << vehicleId_ << "] [MALICIOUS] Claiming impossible position." << endl;

    SafetyMsg* msg = new SafetyMsg("SAFETY_MSG");
    msg->setSenderId(currentPseudonym_.c_str());
    msg->setSpeed(999.0);           // Physically impossible speed (3600 km/h)
    msg->setPosX(99999.0);          // Position outside scenario bounds
    msg->setPosY(99999.0);
    msg->setHeading(0.0);
    msg->setEventType("BEACON");
    msg->setMessageSignature("ghost_sig_abcdef1234");
    msg->setFilterEpochAtSigning(acf_->getEpoch());
    msg->setSigmaSerialized("ghost_sigma_placeholder");
    msg->setClusterId(clusterId_.c_str());
    msg->setIsMalicious(true);

    sendDown(msg);
    msgSent_++;

    emitDashboardEvent("PACKET_EVENT",
        buildPacketEventJson("SAFETY_MSG", currentPseudonym_, "BROADCAST",
                             "SENT", 0.0, true, "impossible_position", ""));
}

// ============================================================
// MESSAGE ROUTING — OMNeT++ calls this for every received frame
// ============================================================

void SwarmVehicle::onWSM(BaseFrame1609_4* wsm) {
    // Route incoming messages to the correct handler
    if (swarmevose::CandidateMsg* m =
            dynamic_cast<swarmevose::CandidateMsg*>(wsm)) {
        handleCandidateMsg(m);
    } else if (swarmevose::PartialSigMsg* m =
                   dynamic_cast<swarmevose::PartialSigMsg*>(wsm)) {
        handlePartialSig(m);
    } else if (swarmevose::SafetyMsg* m =
                   dynamic_cast<swarmevose::SafetyMsg*>(wsm)) {
        handleSafetyMsg(m);
    } else if (swarmevose::RevokeProposalMsg* m =
                   dynamic_cast<swarmevose::RevokeProposalMsg*>(wsm)) {
        handleRevokeProposal(m);
    } else if (swarmevose::RevokeVoteMsg* m =
                   dynamic_cast<swarmevose::RevokeVoteMsg*>(wsm)) {
        handleRevokeVote(m);
    } else if (swarmevose::SignedAcfUpdateMsg* m =
                   dynamic_cast<swarmevose::SignedAcfUpdateMsg*>(wsm)) {
        handleSignedACFUpdate(m);
    }
    // Track neighbour pseudonyms for false revocation targeting
    if (swarmevose::SafetyMsg* m =
            dynamic_cast<swarmevose::SafetyMsg*>(wsm)) {
        std::string sid = m->getSenderId();
        if (std::find(recentNeighbourPseudonyms_.begin(),
                      recentNeighbourPseudonyms_.end(), sid)
            == recentNeighbourPseudonyms_.end()) {
            recentNeighbourPseudonyms_.push_back(sid);
            if (recentNeighbourPseudonyms_.size() > 20)
                recentNeighbourPseudonyms_.erase(recentNeighbourPseudonyms_.begin());
        }
    }
}

