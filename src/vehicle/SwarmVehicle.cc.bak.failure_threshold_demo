// Sign a payload with the current ephemeral pseudonym signing key
KeyBytes SwarmVehicle::signPayload(const std::string& payload) {
    // HMAC-SHA256(currentSigningKey_, payload)
    unsigned char result[32];
    unsigned int len = 32;
    HMAC(EVP_sha256(),
         currentSigningKey_.data(), currentSigningKey_.size(),
         reinterpret_cast<const unsigned char*>(payload.c_str()), payload.size(),
         result, &len);
    return KeyBytes(result, result + len);
}

// Compute fingerprint of a pseudonym for ACF lookup
// fingerprint = SHA256(pseudonym) — truncated to 32 hex chars for compactness
std::string SwarmVehicle::computeFingerprint(const std::string& pseudo) const {
    unsigned char hash[SHA256_DIGEST_LENGTH];
    SHA256(reinterpret_cast<const unsigned char*>(pseudo.c_str()),
           pseudo.size(), hash);
    std::ostringstream oss;
    for (int i = 0; i < 16; ++i)  // First 16 bytes = 32 hex chars
        oss << std::hex << std::setw(2) << std::setfill('0') << (int)hash[i];
    return oss.str();
}

std::string SwarmVehicle::toHex(const KeyBytes& b) const {
    std::ostringstream oss;
    for (uint8_t byte : b)
        oss << std::hex << std::setw(2) << std::setfill('0') << (int)byte;
    return oss.str();
}

uint32_t SwarmVehicle::getNeighbourCount() const {
    // Ask Veins for the number of vehicles currently within DSRC range
    // In Veins this comes from the connection manager
    cModule* connMgr = getModuleByPath("^.^.connectionManager");
    if (!connMgr) return 5;  // Safe default if not found
    // Real Veins API: connMgr->getConnectedLanes() or similar
    // Simplified: return a density estimate from mobility
    return static_cast<uint32_t>(10 + dblrand() * 20);
}

void SwarmVehicle::emitDashboardEvent(const std::string& eventType,
                                      const std::string& data) {
    // Wrap in envelope and send to dashboard WebSocket server
    std::string json = "{\"type\":\"" + eventType + "\"," + data.substr(1);
    // (data is already a JSON object string starting with '{')
    DashboardServer::instance().emitRaw(json);
}

// Update neighbour count based on DSRC packets actually received recently.
// This is demo-friendly and directly reflects vehicles that are in communication range.
void SwarmVehicle::updateObservedNeighbours() {
    simtime_t now = simTime();

    for (auto it = recentNeighbourSeen_.begin(); it != recentNeighbourSeen_.end(); ) {
        if ((now - it->second).dbl() > 3.0) {
            it = recentNeighbourSeen_.erase(it);
        } else {
            ++it;
        }
    }

    neighbourCount_ = recentNeighbourSeen_.size();
}
