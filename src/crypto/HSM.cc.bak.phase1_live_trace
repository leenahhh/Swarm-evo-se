static std::string demoBytesToHexLocal(const KeyBytes& bytes) {
    static const char* hex = "0123456789abcdef";
    std::string out;
    out.reserve(bytes.size() * 2);

    for (uint8_t b : bytes) {
        out.push_back(hex[(b >> 4) & 0x0F]);
        out.push_back(hex[b & 0x0F]);
    }

    return out;
}

std::string HSM::demoExportKMasterHex() const {
    return demoBytesToHexLocal(k_master_);
}

std::string HSM::demoExportPrivateKeyHex() const {
    // In this simulation, K_master acts as the root private scalar/key material.
    // Real BLS implementation would derive/use a scalar from K_master internally.
    return demoBytesToHexLocal(k_master_);
}
